{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurboLayout",
  "version": "0.1.0",
  "identifier": "ar.turbolayout.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui"
  },
  "app": {
    "windows": [{ "title": "TurboLayout", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
